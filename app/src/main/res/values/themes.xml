<resources>
    <!-- Material 3, DayNight: follows the system light/dark setting (and the wallpaper's dynamic
         colour on Android 12+, applied in MainActivity.onCreate). NoActionBar: the module app draws
         its own toolbar, so the tab title can change with the selected bottom-nav destination.

         The bars are pinned to colourSurface with matching icon contrast: Material 3 does not set
         android:statusBarColor at all, so the default comes from the framework theme chain and
         resolves to white on this device. -->
    <style name="Theme.BelfiusRoot" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <!-- The system gesture bar sits right below our BottomNavigationView, which is painted with
             colorSurfaceContainer. Matching it here is what makes the pill area read as part of the
             app instead of a separate strip. -->
        <item name="android:navigationBarColor">?attr/colorSurfaceContainer</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
