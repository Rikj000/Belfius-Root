<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Modern (libxposed API 102) module. There is no xposedmodule / xposeddescription /
      xposedminversion / xposedsharedprefs metadata any more: the module is recognised by
      META-INF/xposed/java_init.list + META-INF/xposed/module.prop, its name comes from
      android:label and its description from android:description.
    -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/app_description"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BelfiusRoot"
        tools:targetApi="31">

        <!-- Settings screen (single "debug logging" switch). Also the way to open the module
             from its launcher icon. The value lives in the framework's remote preferences. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Scripted toggle: see agentic_dev/scripts/reload-and-test.sh (am broadcast ...SET_DEBUG). -->
        <receiver
            android:name=".DebugToggleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="be.belfius.directmobile.android.root.SET_DEBUG" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
